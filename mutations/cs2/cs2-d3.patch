---
 test/infrastructure/compliance/markdown_links_test.dart | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/test/infrastructure/compliance/markdown_links_test.dart b/test/infrastructure/compliance/markdown_links_test.dart
index 7580c5e..ea784ad 100644
--- a/test/infrastructure/compliance/markdown_links_test.dart
+++ b/test/infrastructure/compliance/markdown_links_test.dart
@@ -47,7 +47,12 @@ List<String> findMarkdownFiles(String repoRoot) {
         if (repoRoot != '.' && repoRoot.isNotEmpty && rel.startsWith('$repoRoot/')) {
           rel = rel.substring(repoRoot.length + 1);
         }
-        if (rel.startsWith('./')) rel = rel.substring(2);
+        final basename = segs.last;
+        if (basename.isNotEmpty &&
+            RegExp(r'^[A-Z]').hasMatch(basename) &&
+            basename != 'README.md') {
+          continue;
+        }
         if (rel.endsWith('.md') || rel.endsWith('.antigravityrules')) {
           results.add(rel);
         }
