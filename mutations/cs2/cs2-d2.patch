 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/test/infrastructure/compliance/markdown_links_test.dart b/test/infrastructure/compliance/markdown_links_test.dart
index 7580c5e..4e330bc 100644
--- a/test/infrastructure/compliance/markdown_links_test.dart
+++ b/test/infrastructure/compliance/markdown_links_test.dart
@@ -139,13 +139,10 @@ List<String> markdownLinkProblems(String markdown, String fileDir) {
     }
   }
 
-  // Reference definitions: ^[id]: target (excluding footnote definitions)
+  // Reference definitions: ^[id]: target
   final refDefPattern = RegExp(r'^[ \t]*\[([^\]]+)\]:[ \t]*([^\s]+)', multiLine: true);
   for (final m in refDefPattern.allMatches(cleanMarkdown)) {
     final ref = m.group(1)!;
-    if (ref.startsWith('^')) {
-      continue;
-    }
     checkTarget('[$ref]', m.group(2)!);
   }
 
