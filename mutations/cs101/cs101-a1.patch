From: Kevin Burkeland <kevin@burke.land>
Date: Mon, 9 Nov 2026 17:05:42 -0800
Subject: [PATCH] Mutation cs101-a1: mutate second wind roll formula

Signed-off-by: Kevin Burkeland <kevin@burke.land>
---
 lib/services/rules/character_actions_resolver.dart | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/services/rules/character_actions_resolver.dart b/lib/services/rules/character_actions_resolver.dart
index c24f47ba..789e32cc 100644
--- a/lib/services/rules/character_actions_resolver.dart
+++ b/lib/services/rules/character_actions_resolver.dart
@@ -557,7 +557,7 @@ class CharacterActionsResolver {
               dealsDamage: false,
               use: RollOnUse(ActionRoll(
                 label: 'Second Wind Healing',
-                formula: '1d10+$lvl',
+                formula: '1d12+$lvl',
               )),
             ),
           );
