diff --git a/lib/services/persistence/homebrew/homebrew_category_store.dart b/lib/services/persistence/homebrew/homebrew_category_store.dart
index 16c80b88..c75b01a8 100644
--- a/lib/services/persistence/homebrew/homebrew_category_store.dart
+++ b/lib/services/persistence/homebrew/homebrew_category_store.dart
@@ -201,7 +201,7 @@ class HomebrewCategoryStore<T> {
     final items = await loadAll();
     final removed = <T>[];
     items.removeWhere((e) {
-      final hits = match != null ? match(e) : getEntitySlug(e) == slug;
+      final hits = match != null ? match(e) : toMap(e)['name']?.toString() == slug;
       if (hits) removed.add(e);
       return hits;
     });
