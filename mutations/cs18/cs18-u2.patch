---
 lib/models/arena/arena_combatant.dart                          | 2 +-
 lib/services/rules/arena/arena_challenge_rating_validator.dart | 3 ---
 2 files changed, 1 insertion(+), 4 deletions(-)

diff --git a/lib/models/arena/arena_combatant.dart b/lib/models/arena/arena_combatant.dart
index 20667cee..db403aca 100644
--- a/lib/models/arena/arena_combatant.dart
+++ b/lib/models/arena/arena_combatant.dart
@@ -290,7 +290,7 @@ class ArenaCombatant {
     final rawMaxHp = hpOverride ?? sb.maxHp;
     final rawAc = acOverride ?? sb.ac;
     final effectiveHp = (rawMaxHp != null && rawMaxHp > 0) ? rawMaxHp : 0;
-    final effectiveAc = (rawAc != null && rawAc > 0) ? rawAc : 0;
+    final effectiveAc = (rawAc != null && rawAc > 0) ? rawAc : 10;
     final name = customName ?? monster.getName(edition);
     final profile = monster.getCombatProfile(edition);
 
diff --git a/lib/services/rules/arena/arena_challenge_rating_validator.dart b/lib/services/rules/arena/arena_challenge_rating_validator.dart
index 8e877a31..371b4f1c 100644
--- a/lib/services/rules/arena/arena_challenge_rating_validator.dart
+++ b/lib/services/rules/arena/arena_challenge_rating_validator.dart
@@ -41,9 +41,6 @@ void validateArenaCombatantsChallengeRatings(
   for (final combatant in combatants) {
     final sb = combatant.monster.getStatBlock(edition);
     final missing = <String>[];
-    if (sb.ac == null && !combatant.hasExplicitAcOverride) {
-      missing.add('armor class');
-    }
     if (sb.maxHp == null && !combatant.hasExplicitHpOverride) {
       missing.add('hit points');
     }
