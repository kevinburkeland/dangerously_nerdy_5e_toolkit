 lib/infrastructure/dtos/campaign_edition_codec.dart | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/lib/infrastructure/dtos/campaign_edition_codec.dart b/lib/infrastructure/dtos/campaign_edition_codec.dart
index 5b502d8..3868f95 100644
--- a/lib/infrastructure/dtos/campaign_edition_codec.dart
+++ b/lib/infrastructure/dtos/campaign_edition_codec.dart
@@ -11,7 +11,11 @@ import 'package:vtt_ruleset_dnd5e/vtt_ruleset_dnd5e.dart';
 RulesetRef parseStoredCampaignEdition(String raw) {
   final clean = raw.trim().toLowerCase();
 
-  if (clean.isEmpty || clean == 'generic_tabletop' || clean == 'unknown') {
+  // Mutation cs3-l2: map generic_tabletop to v2014
+  if (clean == 'generic_tabletop') {
+    return RulesetEdition.v2014;
+  }
+  if (clean.isEmpty || clean == 'unknown') {
     return RulesetEdition.v2024;
   }
 
