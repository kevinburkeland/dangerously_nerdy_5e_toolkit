diff --git a/lib/infrastructure/repositories/campaign_storage_migration.dart b/lib/infrastructure/repositories/campaign_storage_migration.dart
index 80c7afb..e88b89c 100644
--- a/lib/infrastructure/repositories/campaign_storage_migration.dart
+++ b/lib/infrastructure/repositories/campaign_storage_migration.dart
@@ -43,6 +43,12 @@ class CampaignStorageMigration {
 
     final db = databaseService ?? AppDatabaseService.instance;
     final charService = characterPersistenceService ?? CharacterPersistenceService();
+
+    // Mutation cs3-l5: rewrite every profile on every boot with fresh timestamp
+    final profiles = await repo.loadAllProfiles();
+    for (final p in profiles) {
+      await repo.updateProfile(p.id, (curr) => curr.copyWith(lastPlayedAt: DateTime.now()));
+    }
     final regService = registryService ?? CampaignRegistryService();
 
     // Ensure storage records are loaded and prefs->hive copy completes
