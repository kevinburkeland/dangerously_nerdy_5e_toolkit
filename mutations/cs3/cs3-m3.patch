 scripts/retire_mutation_branches.sh | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/retire_mutation_branches.sh b/scripts/retire_mutation_branches.sh
index 31e1910..c64a0b1 100755
--- a/scripts/retire_mutation_branches.sh
+++ b/scripts/retire_mutation_branches.sh
@@ -304,7 +304,8 @@ delete_args=()
 for i in "${!matched_branches[@]}"; do
   b="${matched_branches[$i]}"
   head_sha="${matched_heads[$i]}"
-  delete_args+=("--force-with-lease=refs/heads/$b:$head_sha" ":refs/heads/$b")
+  # Mutation cs3-m3: dropped --force-with-lease
+  delete_args+=(":refs/heads/$b")
 done
 
 if ! git push --atomic origin "${delete_args[@]}"; then
