---
 test/infrastructure/compliance/docs_truth_test.dart | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/test/infrastructure/compliance/docs_truth_test.dart b/test/infrastructure/compliance/docs_truth_test.dart
index 198bf76..3deb0db 100644
--- a/test/infrastructure/compliance/docs_truth_test.dart
+++ b/test/infrastructure/compliance/docs_truth_test.dart
@@ -136,12 +136,10 @@ List<String> unknownClassNames(String doc, Set<String> declared, Set<String> all
     if (fileExtensions.any((ext) => raw.endsWith(ext))) {
       continue;
     }
-    final parts = raw.split(RegExp(r'[^a-zA-Z0-9_]+'));
-    for (final ident in parts) {
-      if (capIdentPattern.hasMatch(ident)) {
-        if (!declared.contains(ident) && !allowlist.contains(ident)) {
-          problems.add('Unknown class name: `$raw` (identifier: $ident)');
-        }
+    // Mutation cs3-d1: only check single-identifier spans
+    if (capIdentPattern.hasMatch(raw)) {
+      if (!declared.contains(raw) && !allowlist.contains(raw)) {
+        problems.add('Unknown class name: `$raw`');
       }
     }
   }
