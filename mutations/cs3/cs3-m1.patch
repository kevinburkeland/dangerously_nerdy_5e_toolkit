---
 scripts/retire_mutation_branches.sh | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/retire_mutation_branches.sh b/scripts/retire_mutation_branches.sh
index 31e1910..72cc48d 100755
--- a/scripts/retire_mutation_branches.sh
+++ b/scripts/retire_mutation_branches.sh
@@ -226,7 +226,8 @@ if [ "$any_needs_archive" -eq 1 ]; then
       git am "$patch_file" >/dev/null 2>&1
       am_tree=$(git rev-parse HEAD^{tree})
       expected_tree=$(git rev-parse "${head_sha}^{tree}")
-      if [ "$am_tree" != "$expected_tree" ]; then
+      # Tree comparison intentionally skipped for mutation cs3-m1
+      if false && [ "$am_tree" != "$expected_tree" ]; then
         echo "Error: Tree mismatch for patch '$patch_file'. Expected $expected_tree, got $am_tree." >&2
         exit 1
       fi
