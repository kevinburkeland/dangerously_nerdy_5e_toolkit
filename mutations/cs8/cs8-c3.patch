---
 .github/workflows/release.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index f004e95f..44e08d55 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -77,7 +77,7 @@ jobs:
 
       - name: 🧪 Execute Sharded Unit & Widget Test Suite with Coverage
         run: |
-          python3 -I scripts/test_shard.py list ${{ strategy.job-index }} ${{ strategy.job-total }} > "$RUNNER_TEMP/shard_files.txt"
+          python3 -I scripts/test_shard.py list ${{ strategy.job-index }} 4 > "$RUNNER_TEMP/shard_files.txt"
           echo "Shard ${{ strategy.job-index }} of ${{ strategy.job-total }}: $(wc -l < "$RUNNER_TEMP/shard_files.txt") files"
           mapfile -t files < "$RUNNER_TEMP/shard_files.txt"
           [ "${#files[@]}" -gt 0 ] || { echo "empty shard"; exit 1; }
