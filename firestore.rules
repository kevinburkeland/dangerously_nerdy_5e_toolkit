rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidAppCheck() {
      return request.auth != null || request.app != null;
    }

    match /rooms/{roomCode} {
      allow read: if isValidAppCheck() && resource != null;
      // Allow create if room doesn't exist and expiresAt <= 30 days
      allow create: if isValidAppCheck()
        && request.resource.data.keys().hasAll(['campaignName', 'partyPurse', 'hostKeyHash', 'version', 'expiresAt'])
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      // Allow updates only if version is monotonically increasing
      allow update: if isValidAppCheck()
        && resource != null
        && request.resource.data.version > resource.data.version
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');

      match /loot/{lootId} {
        allow read: if isValidAppCheck();
        allow write: if isValidAppCheck();
      }

      match /events/{eventId} {
        allow read: if isValidAppCheck();
        allow create: if isValidAppCheck();
        allow update, delete: if false; // Append-only audit log
      }

      match /rolls/{rollId} {
        allow read, write: if isValidAppCheck();
      }
    }
  }
}
