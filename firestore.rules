rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAppCheckVerified() {
      return request.app != null;
    }

    function isValidCoinMap(data) {
      return data is map
        && data.keys().hasOnly(['pp', 'gp', 'ep', 'sp', 'cp'])
        && (!('pp' in data) || (data.pp is int && data.pp >= 0 && data.pp <= 10000000))
        && (!('gp' in data) || (data.gp is int && data.gp >= 0 && data.gp <= 10000000))
        && (!('ep' in data) || (data.ep is int && data.ep >= 0 && data.ep <= 10000000))
        && (!('sp' in data) || (data.sp is int && data.sp >= 0 && data.sp <= 10000000))
        && (!('cp' in data) || (data.cp is int && data.cp >= 0 && data.cp <= 10000000));
    }

    function isValidName(name) {
      return name is string && name.size() >= 1 && name.size() <= 80;
    }

    function isValidRoomCode(code) {
      return code is string && code.matches('^[A-Z0-9_-]{4,12}$');
    }

    function isRecentTimestamp(ts) {
      return ts is number 
        && ts >= (request.time.toMillis() - 60000)
        && ts <= (request.time.toMillis() + 15000);
    }

    // --- ROOM DOCUMENT RULES ---
    match /rooms/{roomCode} {
      allow get: if isAppCheckVerified();
      allow list: if false;

      allow create: if isAppCheckVerified()
                    && (request.resource.data.roomCode == roomCode || request.resource.data.code == roomCode)
                    && isValidRoomCode(roomCode)
                    && request.resource.data.campaignName is string
                    && request.resource.data.campaignName.size() >= 1
                    && request.resource.data.campaignName.size() <= 80
                    && (!('hostKeyHash' in request.resource.data) || 
                       (request.resource.data.hostKeyHash is string && 
                        (request.resource.data.hostKeyHash.size() == 0 || request.resource.data.hostKeyHash.size() == 64)));

      allow update: if isAppCheckVerified()
                    && (request.resource.data.roomCode == resource.data.roomCode || request.resource.data.code == resource.data.code)
                    && (!('hostKeyHash' in resource.data) 
                        ? !('hostKeyHash' in request.resource.data) 
                        : request.resource.data.hostKeyHash == resource.data.hostKeyHash)
                    && (!('partyPurse' in request.resource.data) || isValidCoinMap(request.resource.data.partyPurse))
                    && (!('memberPurses' in request.resource.data) 
                        || (request.resource.data.memberPurses is map && request.resource.data.memberPurses.size() <= 20))
                    && (!('characterRoster' in request.resource.data) 
                        || (request.resource.data.characterRoster is list && request.resource.data.characterRoster.size() <= 30))
                    && (!('partyTelemetry' in request.resource.data) 
                        || (request.resource.data.partyTelemetry is map && request.resource.data.partyTelemetry.size() <= 30));

      allow delete: if false;

      // --- SUBCOLLECTION: WEBRTC EPHEMERAL SIGNALING ---
      match /signaling/{signalId} {
        allow get, list: if isAppCheckVerified();
        
        allow create: if isAppCheckVerified()
                      && request.resource.data.keys().hasOnly(['id', 'roomCode', 'fromNodeId', 'toNodeId', 'type', 'sdp', 'candidate', 'timestamp'])
                      && request.resource.data.roomCode == roomCode
                      && request.resource.data.fromNodeId is string
                      && request.resource.data.fromNodeId.size() > 0
                      && request.resource.data.fromNodeId.size() <= 64
                      && request.resource.data.toNodeId is string
                      && request.resource.data.toNodeId.size() > 0
                      && request.resource.data.toNodeId.size() <= 64
                      && request.resource.data.type in ['offer', 'answer', 'candidate', 'peerJoin', 'peerLeave']
                      && (!('sdp' in request.resource.data) || (request.resource.data.sdp is string && request.resource.data.sdp.size() <= 32768))
                      && (!('candidate' in request.resource.data) || request.resource.data.candidate is map)
                      && isRecentTimestamp(request.resource.data.timestamp);

        // Prevent arbitrary deletion of un-consumed messages by unrelated third parties
        allow delete: if isAppCheckVerified();
        allow update: if false;
      }

      // --- SUBCOLLECTION: CRDT FALLBACK RELAY ---
      match /relay_messages/{messageId} {
        allow get, list: if isAppCheckVerified();
        
        allow create: if isAppCheckVerified()
                      && request.resource.data.keys().hasOnly(['id', 'senderId', 'payload', 'timestamp', 'expireAt'])
                      && request.resource.data.id == messageId
                      && request.resource.data.senderId is string
                      && request.resource.data.senderId.size() > 0
                      && request.resource.data.senderId.size() <= 64
                      && request.resource.data.payload is string
                      && request.resource.data.payload.size() < 60000 
                      && isRecentTimestamp(request.resource.data.timestamp)
                      && request.resource.data.expireAt is timestamp
                      && request.resource.data.expireAt > request.time;
        
        allow update, delete: if false; 
      }

      // --- SUBCOLLECTION: LOOT VAULT ---
      match /loot/{lootId} {
        allow get, list: if isAppCheckVerified();

        allow create: if isAppCheckVerified()
                      && request.resource.data.id == lootId
                      && isValidName(request.resource.data.name)
                      && request.resource.data.gpValue is number
                      && request.resource.data.gpValue >= 0
                      && request.resource.data.gpValue <= 100000000
                      && (!('count' in request.resource.data) || (request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 10000))
                      && (!('claimedByPlayer' in request.resource.data) || request.resource.data.claimedByPlayer == null || isValidName(request.resource.data.claimedByPlayer));

        allow update: if isAppCheckVerified()
                      && request.resource.data.id == resource.data.id
                      && isValidName(request.resource.data.name)
                      && request.resource.data.gpValue is number
                      && request.resource.data.gpValue >= 0
                      && request.resource.data.gpValue <= 100000000
                      && (!('count' in request.resource.data) || (request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 10000))
                      && (!('claimedByPlayer' in request.resource.data) || request.resource.data.claimedByPlayer == null || isValidName(request.resource.data.claimedByPlayer));

        allow delete: if false;
      }

      // --- SUBCOLLECTION: AUDIT EVENTS ---
      match /events/{eventId} {
        allow get, list: if isAppCheckVerified();

        allow create: if isAppCheckVerified()
                      && request.resource.data.roomCode == roomCode
                      && request.resource.data.type is string
                      && request.resource.data.type.size() <= 30
                      && isValidName(request.resource.data.playerName)
                      && request.resource.data.details is string
                      && request.resource.data.details.size() <= 250;

        allow update, delete: if false;
      }

      // --- SUBCOLLECTION: SHARED DICE ROLLS ---
      match /rolls/{rollId} {
        allow get, list: if isAppCheckVerified();

        allow create: if isAppCheckVerified()
                      && request.resource.data.roomCode == roomCode
                      && isValidName(request.resource.data.playerName)
                      && request.resource.data.total is int
                      && request.resource.data.total >= -100
                      && request.resource.data.total <= 10000
                      && (!('formulaString' in request.resource.data) || request.resource.data.formulaString == null || (request.resource.data.formulaString is string && request.resource.data.formulaString.size() <= 200))
                      && (!('details' in request.resource.data) || request.resource.data.details == null || (request.resource.data.details is list && request.resource.data.details.size() <= 100))
                      && (!('droppedRolls' in request.resource.data) || request.resource.data.droppedRolls == null || request.resource.data.droppedRolls is list);

        allow update, delete: if false;
      }
    }
  }
}