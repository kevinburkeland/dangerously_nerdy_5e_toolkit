rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared TTRPG dice rolling rooms and roll history
    match /rooms/{roomCode} {
      allow read, write: if true;

      match /rolls/{rollId} {
        allow read, create: if true;
        allow update, delete: if false; // Preserve roll integrity (rolls are append-only)
      }
    }
  }
}
