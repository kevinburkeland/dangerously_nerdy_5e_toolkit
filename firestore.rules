rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms collection (Party Rooms, Shared Vaults, and Dice Rooms)
    match /rooms/{roomCode} {
      // Allow reading rooms
      allow read: if true;

      // Allow creating a new room document
      allow create: if request.resource.data.keys().hasAny(['campaignName', 'code', 'roomCode']);

      // Allow updating room metadata, party purse, and player roster
      allow update: if true;

      // Prevent hard deletion of entire rooms from client devices
      allow delete: if false;

      // Subcollection for loot items in the party vault
      match /loot/{lootId} {
        allow read, write: if true;
      }

      // Subcollection for immutable audit events
      match /events/{eventId} {
        allow read, create: if true;
        allow update, delete: if false; // Append-only audit log
      }

      // Subcollection for shared live dice rolls
      match /rolls/{rollId} {
        allow read, write: if true;
      }
    }
  }
}
